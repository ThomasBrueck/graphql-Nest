			"item": [
				{
					"name": "Signup Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has token', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.signup).to.have.property('token');",
									"    pm.expect(jsonData.data.signup.token).to.be.a('string').and.not.empty;",
									"});",
									"",
									"pm.test('User has admin role', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.signup.user.roles).to.include('admin');",
									"});",
									"",
									"pm.test('User is active', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.signup.user.isActive).to.be.true;",
									"});",
									"",
									"// Save token and user info",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('adminToken', response.data.signup.token);",
									"    pm.environment.set('adminId', response.data.signup.user.id);",
									"    pm.environment.set('adminEmail', response.data.signup.user.email);",
									"    console.log(' Admin token saved:', response.data.signup.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation Signup($signupInput: SignupInput!) {\n  signup(signupInput: $signupInput) {\n    token\n    user {\n      id\n      name\n      email\n      roles\n      isActive\n    }\n  }\n}",
								"variables": "{\n  \"signupInput\": {\n    \"name\": \"Admin Test\",\n    \"email\": \"{{adminEmail}}\",\n    \"password\": \"{{adminPassword}}\",\n    \"roles\": [\"admin\"]\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "Registra un usuario administrador"
					},
					"response": []
				},
