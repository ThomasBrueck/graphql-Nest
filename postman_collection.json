									"        pm.expect(movie).to.have.property('director');",
									"        pm.expect(movie).to.have.property('releaseYear');",
									"        pm.expect(movie).to.have.property('duration');",
									"        pm.expect(movie).to.have.property('genre');",
									"        // Save first movie ID for later tests",
									"        pm.environment.set('movieId', movie.id);",
									"    }",
