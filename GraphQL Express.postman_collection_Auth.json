		{
			"name": "Auth",
			"item": [
				{
					"name": "Register Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.register && response.data.register.token) {",
									"        pm.environment.set('token', response.data.register.token);",
									"        pm.environment.set('adminEmail', response.data.register.user.email);",
									"        pm.environment.set('adminId', response.data.register.user.id);",
									"        console.log('✅ Token guardado:', response.data.register.token);",
									"    }",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation Signup($signupInput: SignupInput!) {\n  signup(signupInput: $signupInput) {\n    token\n    user {\n      id\n      name\n      email\n      roles\n      isActive\n    }\n  }\n}",
								"variables": "{\n  \"signupInput\": {\n    \"name\": \"Admin User\",\n    \"email\": \"admin@example.com\",\n    \"password\": \"Admin123!\",\n    \"roles\": [\"admin\"]\n  }\n}"
							}
						},
						"url": {
							"raw": "http://localhost:3000/graphql",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"graphql"
							]
						},
						"description": "Registra un usuario administrador. El token se guarda automáticamente."
					},
					"response": []
				},
